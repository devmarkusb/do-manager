{
  "name": "do-manager",
  "private": true,
  "license": "MIT",
  "description": "Personal work queue manager — attention state, not task lists",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @do-manager/api --filter @do-manager/web dev",
    "dev:api": "pnpm --filter @do-manager/api dev",
    "dev:web": "pnpm --filter @do-manager/web dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test": "pnpm --filter @do-manager/core build && pnpm -r test",
    "typecheck": "pnpm --filter @do-manager/core build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^10.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
